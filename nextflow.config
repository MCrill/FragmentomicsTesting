// ============================================================================
//  cfDNA Fragmentomics + NuPEM  -  Nextflow configuration
// ============================================================================

manifest {
    name            = 'cfdna-fragmentomics-nupem'
    author          = 'Morgan'
    description     = 'cfDNA fragmentomics pipeline with the NuPEM coupling metric'
    version         = '0.1.0'
    nextflowVersion = '>=23.04.0'
}

params {
    // --- inputs ---
    samplesheet   = null            // CSV: sample_id,fastq_1,fastq_2
    reference     = null            // indexed FASTA (.fa + .fai)
    bwa_index     = null            // bwa-mem2 index files (glob)
    regions_bed   = null            // analysis regions for WPS/NuPEM
    blacklist     = null            // ENCODE blacklist BED
    outdir        = 'results'

    // --- params ---
    min_mapq      = 30
    min_frag_len  = 50
    max_frag_len  = 1000
    motif_k       = 4
}

process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withLabel: process_low    { cpus = 2;  memory = 4.GB;  time = 2.h  }
    withLabel: process_medium { cpus = 4;  memory = 16.GB; time = 6.h  }
    withLabel: process_high   { cpus = 12; memory = 48.GB; time = 12.h }
}

profiles {
    standard { process.executor = 'local' }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ghcr.io/morgan/cfdna-fragmentomics-nupem:0.1.0'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container = 'docker://ghcr.io/morgan/cfdna-fragmentomics-nupem:0.1.0'
    }

    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'compute'
    }

    test { includeConfig 'conf/test.config' }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html" }
