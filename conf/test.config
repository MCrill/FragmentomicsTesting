/*
 * Minimal config for a smoke test on a tiny chr20 slice.
 * Point the params at small test files before running:
 *   nextflow run main.nf -profile test,docker
 */
params {
    samplesheet  = "${projectDir}/assets/samplesheet.example.csv"
    reference    = "${projectDir}/assets/test/chr20_slice.fa"
    bwa_index    = "${projectDir}/assets/test/chr20_slice.fa.*"
    regions_bed  = "${projectDir}/assets/test/regions.bed"
    blacklist    = "${projectDir}/assets/test/blacklist.bed"
    outdir       = 'results_test'
}

process {
    withLabel: process_low    { cpus = 1; memory = 2.GB }
    withLabel: process_medium { cpus = 2; memory = 4.GB }
    withLabel: process_high   { cpus = 2; memory = 6.GB }
}
